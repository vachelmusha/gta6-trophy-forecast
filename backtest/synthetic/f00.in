": "bronze", "points": 15, "secret": true}, {"id": 28, "name": "Positive Mental Attitude", "description": "Meditate at every spot across Leonida.", "tier": "bronze", "points": 15, "secret": false}, {"id": 29, "name": "Fair Game", "description": "Hunt a unique animal for Bret.", "tier": "bronze", "points": 15, "secret": true}, {"id": 30, "name": "Don't Touch My Deck", "description": "Complete 3 Collectible Card sets.", "tier": "silver", "points": 30, "secret": false}, {"id": 31, "name": "You WAiNKer!", "description": "WAiNK It at 100 locations.", "tier": "silver", "points": 30, "secret": false}, {"id": 32, "name": "One Last Thing", "description": "Complete 50 Challenges.", "tier": "bronze", "points": 15, "secret": false}, {"id": 33, "name": "Hot Together", "description": "Lose a 4 star Wanted Level with your partner and escape the heat.", "tier": "bronze", "points": 15, "secret": false}, {"id": 34, "name": "Retail Therapy", "description": "Rob 3 shops back-to-back with your partner without losing your Wanted Level.", "tier": "bronze", "points": 15, "secret": false}, {"id": 35, "name": "Whip It Good", "description": "Discover 100 vehicles.", "tier": "bronze", "points": 15, "secret": false}, {"id": 36, "name": "Gunslinger", "description": "Take down 5 enemies in a single use of Combat Focus.", "tier": "bronze", "points": 15, "secret": false}, {"id": 37, "name": "Catch Me If You Can", "description": "Make an unscheduled departure at VCIA.", "tier": "bronze", "points": 15, "secret": true}, {"id": 38, "name": "Challenging Tank", "description": "Kinda hot in these Rhinos.", "tier": "bronze", "points": 15, "secret": true}, {"id": 39, "name": "Sneakthief", "description": "Rob a jewelry store without being detected.", "tier": "bronze", "points": 15, "secret": false}, {"id": 40, "name": "Maximum Withdrawal", "description": "Rob 5 Bank Vaults and escape.", "tier": "silver", "points": 30, "secret": false}, {"id": 41, "name": "A Classic Blitz Play", "description": "Rob an Armored Truck and escape.", "tier": "bronze", "points": 15, "secret": false}, {"id": 42, "name": "The Goodtime State", "description": "Explore all of Leonida.", "tier": "bronze", "points": 15, "secret": false}, {"id": 43, "name": "Pest Control", "description": "Rob an Illegal Operation belonging to each gang.", "tier": "bronze", "points": 15, "secret": false}, {"id": 44, "name": "In The Beginning\u2026", "description": "Enjoy a cocktail with a view on Ocean Beach.", "tier": "bronze", "points": 15, "secret": true}, {"id": 45, "name": "Capital Offense", "description": "Smash your way out of a vehicle showroom in classic style.", "tier": "bronze", "points": 15, "secret": true}, {"id": 46, "name": "Let\u2019s Go Bowling", "description": "Follow-through at the Kolt & Associates' bowling alley.", "tier": "bronze", "points": 15, "secret": true}, {"id": 47, "name": "Personal Best", "description": "A partnership with mass appeal.", "tier": "bronze", "points": 15, "secret": true}, {"id": 48, "name": "Actions Speak Louder", "description": "Choices made (for better or worse).", "tier": "bronze", "points": 15, "secret": true}, {"id": 49, "name": "Bad Luck, I Guess", "description": "Second time's the charm.", "tier": "bronze", "points": 15, "secret": true}, {"id": 50, "name": "The Truth Is Out There", "description": "What the hell just happened?", "tier": "bronze", "points": 15, "secret": true}, {"id": 51, "name": "Ten Pin", "description": "Bowl 'em over with a melee drive-by.", "tier": "bronze", "points": 15, "secret": true}, {"id": 52, "name": "Dime on the Dollar", "description": "Earn $250,000 laundering Marked Bills through your contacts.", "tier": "bronze", "points": 15, "secret": false}, {"id": 53, "name": "Treat Yo Self", "description": "Spend $100,000 across all shops.", "tier": "bronze", "points": 15, "secret": false}, {"id": 54, "name": "Little Boxes", "description": "Purchase all garage properties.", "tier": "bronze", "points": 15, "secret": false}, {"id": 55, "name": "On the Spot", "description": "Register 10 vehicles to the Scooter Bros app.", "tier": "bronze", "points": 15, "secret": false}], "history": [{"slot": "2026-11-18T23:50:00Z", "at": "2026-11-18T23:50:01Z", "players_tracked": 638, "trophies_earned": 914, "rates": [0.78, 100.0, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78]}, {"slot": "2026-11-19T00:20:00Z", "at": "2026-11-19T00:20:01Z", "players_tracked": 638, "trophies_earned": 914, "rates": [0.78, 100.0, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78]}, {"slot": "2026-11-19T00:50:00Z", "at": "2026-11-19T00:50:01Z", "players_tracked": 638, "trophies_earned": 914, "rates": [0.78, 100.0, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78]}, {"slot": "2026-11-19T01:20:00Z", "at": "2026-11-19T01:20:01Z", "players_tracked": 638, "trophies_earned": 914, "rates": [0.78, 100.0, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 1.41, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78, 0.78]}, {"slot": "2026-11-19T01:50:00Z", "at": "2026-11-1